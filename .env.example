# Wallet / Web3 environment
# Copy to `.env` for local builds. Gameplay remains available without these values.

# Optional WalletConnect / analytics project id (not required for MetaMask Connect)
EXPO_PUBLIC_WALLET_CONNECT_PROJECT_ID=

# Optional Infura key for MetaMask SDK fallback RPC
EXPO_PUBLIC_INFURA_KEY=

# Feature flags (hackathon defaults)
EXPO_PUBLIC_DEMO_MODE=true
EXPO_PUBLIC_DEMO_WORLD_DATA=true
EXPO_PUBLIC_LIVE_CHAIN_WRITES=false
EXPO_PUBLIC_REALTIME_MULTIPLAYER=false
EXPO_PUBLIC_ENABLE_WALLET=true
EXPO_PUBLIC_ENABLE_GOVERNANCE=true
EXPO_PUBLIC_ENABLE_3D_WORLD=true

# Never put private keys, mnemonics, or seed phrases in this file or in the app bundle.
# PRIVATE_KEY=
# MNEMONIC=

# Contract addresses (must be 0x-prefixed 40-hex characters)
EXPO_PUBLIC_GAME_CONTRACT=
EXPO_PUBLIC_NFT_CONTRACT=
EXPO_PUBLIC_TOKEN_CONTRACT=
EXPO_PUBLIC_REPUTATION_CONTRACT=

# Network configuration
# Polygon Amoy: 80002, Polygon: 137, Ethereum: 1
EXPO_PUBLIC_DEFAULT_CHAIN_ID=80002

# RPC URLs
EXPO_PUBLIC_POLYGON_RPC=https://polygon-rpc.com
EXPO_PUBLIC_AMOY_RPC=https://rpc-amoy.polygon.technology
EXPO_PUBLIC_ETHEREUM_RPC=https://cloudflare-eth.com

# Optional Colyseus / WebSocket game server. When empty, the companion uses a local room.
EXPO_PUBLIC_GAME_SERVER_URL=

# Optional Decentraland World URL for the mobile "Open 3D World" action.
# Leave empty to fall back to the public plaza preview.
EXPO_PUBLIC_DECENTRALAND_WORLD_URL=

# Placeholder World name until a real .dcl.eth name is published.
WORLD_NAME_FROM_ENV=YOUR-NAME.dcl.eth
EXPO_PUBLIC_WORLD_NAME=YOUR-NAME.dcl.eth

# Optional HTTPS invite host. When empty, QR codes use friendzone://world?room=CODE
EXPO_PUBLIC_FRIENDZONE_DEEPLINK_HOST=

# Set true for screen recordings and judging (deterministic clock/seed).
PRESENTATION_MODE=false
EXPO_PUBLIC_PRESENTATION_MODE=false
