# Copy to .env and fill in values before deploying to Polygon Amoy / mainnet.
# Never commit a real private key.

PRIVATE_KEY=
AMOY_RPC_URL=https://rpc-amoy.polygon.technology
POLYGON_RPC_URL=https://polygon-rpc.com
POLYGONSCAN_API_KEY=

# Chainlink VRF v2.5 on Polygon Amoy (optional — omit to use MockVRFCoordinator)
# Coordinator: 0x343300b5d84D3Cc2f91fe8a8b99D75f2dEc5B4A8
VRF_COORDINATOR=
SUBSCRIPTION_ID=0
KEY_HASH=
REPORT_GAS=

# Optional reuse when deploying the social suite (scripts/deploy-social.ts)
FZONE_ADDRESS=
NFT_CONTRACT=
