{
  "compilerOptions": {
    "target": "ES2020",
    "module": "commonjs",
    "strict": true,
    "esModuleInterop": true,
    "forceConsistentCasingInFileNames": true,
    "resolveJsonModule": true,
    "outDir": "dist",
    "declaration": true,
    "skipLibCheck": true,
    "types": ["node", "mocha"]
  },
  "include": ["./scripts", "./test", "./hardhat.config.ts"],
  "exclude": ["./cache", "./artifacts", "./node_modules"]
}
